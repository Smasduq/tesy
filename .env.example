# Copy to .env and fill in the values you need.
# Variables already exported in your shell take precedence over this file.

# --- OpenRouter (default backend) -------------------------------------------
# Key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional: pick a model, see `python main.py --list-models`
# OPENROUTER_MODEL=anthropic/claude-haiku-5.5
# Optional: sent to OpenRouter for app attribution
# OPENROUTER_APP_TITLE=Tesy
# OPENROUTER_HTTP_REFERER=https://github.com/Smasduq/tesy

# --- Snowflake Cortex (backup backend) -------------------------------------
# Use with: python main.py --provider snowflake "hello"
SNOWFLAKE_ACCOUNT_URL=
SNOWFLAKE_PAT=

# --- General ----------------------------------------------------------------
# Default backend when --provider is not given
# TESY_PROVIDER=openrouter
# System prompt
# TESY_SYSTEM=You are Tesy, a warm and curious co-worker and friend.

# --- Voice (python main.py --talk) ------------------------------------------
# Run scripts/install_voice.sh once to download the voice stack.
# TESY_VOICE_DIR=/home/you/.local/share/tesy
# PipeWire source, or file:/path/to/16k-mono.wav to replay a clip
# TESY_MIC_SOURCE=alsa_input.pci-0000_00_1f.3.analog-stereo
# PipeWire sink for the spoken reply
# TESY_SPEAKER=alsa_output.pci-0000_00_1f.3.analog-stereo
# TESY_STT_MODEL=/home/you/.local/share/tesy/models/ggml-base.en.bin
# TESY_HIGH_PASS_HZ=100
# TESY_VAD_SILENCE_MS=700
# TESY_STT_THREADS=4
